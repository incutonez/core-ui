{
  "name": "@incutonez/core-ui",
  "description": "Core UI Components built with PrimeVue",
  "type": "module",
  "version": "3.0.13",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/incutonez/core-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "author": "incutonez@hotmail.com",
  "keywords": [
    "primevue",
    "typescript",
    "vue",
    "vite"
  ],
  "scripts": {
    "dev": "vite --config vite/config.dev.ts",
    "build": "npx tsx makeIndex.ts && vite build --config vite/config.prod.ts",
    "gh-pages": "npx tsx makeIndex.ts && vite build --config vite/config.gh.ts",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@material-symbols/svg-400": "0.47.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@stylistic/stylelint-config": "5.0.0",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "10.4.0",
    "eslint-plugin-antfu": "3.2.3",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-vue": "10.10.0",
    "just-clone": "6.2.0",
    "just-safe-get": "4.2.0",
    "lodash-es": "4.18.1",
    "mime-types": "3.0.2",
    "path-browserify": "1.0.1",
    "pluralize": "8.0.0",
    "primevue": "4.3.9",
    "stylelint": "17.11.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-vue": "2.0.0",
    "tailwindcss-primeui": "0.6.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite-svg-loader": "5.1.3",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.0.3",
    "@semantic-release/git": "^10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/lodash-es": "4.17.12",
    "@types/mime-types": "3.0.1",
    "@types/node": "24.13.3",
    "@types/pluralize": "0.0.33",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "glob": "13.0.6",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "semantic-release": "24.2.9",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "vue-tsc": "3.3.11"
  },
  "lint-staged": {
    "src/*.{js,mjs,cjs,jsx,ts,tsx,vue}": [
      "npx eslint --fix"
    ]
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  },
  "exports": {
    ".": {
      "import": "./dist/components/index.js"
    },
    "./assets": {
      "import": "./dist/assets/index.js"
    },
    "./types": {
      "import": "./dist/types/index.js"
    },
    "./utils": {
      "import": "./dist/utils/index.js"
    },
    "./theme": {
      "import": "./dist/theme.js"
    },
    "./theme.css": "./src/theme.css"
  }
}
