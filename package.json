{
  "name": "@incutonez/core-ui",
  "description": "Core UI Components built with PrimeVue",
  "type": "module",
  "version": "1.4.0",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/incutonez/core-ui.git"
  },
  "author": "incutonez@hotmail.com",
  "keywords": [
    "primevue",
    "typescript",
    "vue",
    "vite"
  ],
  "scripts": {
    "dev": "vite --config vite/config.dev.ts",
    "build": "npx tsx makeIndex.ts && vite build --config vite/config.prod.ts",
    "gh-pages": "npx tsx makeIndex.ts && vite build --config vite/config.gh.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@material-symbols/svg-400": "^0.28.2",
    "just-clone": "^6.2.0",
    "just-safe-get": "^4.2.0",
    "lodash-es": "^4.17.21",
    "mime-types": "^2.1.35",
    "path-browserify": "^1.0.1",
    "pluralize": "^8.0.0",
    "primevue": "^4.3.1",
    "tailwindcss-primeui": "^0.5.1",
    "vite-svg-loader": "^5.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@faker-js/faker": "^9.5.0",
    "@incutonez/eslint-plugin": "^1.1.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.0.3",
    "@semantic-release/git": "^10.0.1",
    "@stylistic/eslint-plugin-ts": "^4.1.0",
    "@stylistic/stylelint-config": "^2.0.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.13.5",
    "@types/pluralize": "^0.0.33",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "^9.32.0",
    "glob": "^11.0.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "semantic-release": "^24.2.3",
    "stylelint": "^16.14.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^4.5.0",
    "vue-tsc": "2.2.4"
  },
  "lint-staged": {
    "src/*.{js,mjs,cjs,jsx,ts,tsx,vue}": [
      "npx eslint --fix"
    ]
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "exports": {
    ".": {
      "import": "./dist/components/index.js"
    },
    "./assets": {
      "import": "./dist/assets/index.js"
    },
    "./types": {
      "import": "./dist/types/index.js"
    },
    "./utils": {
      "import": "./dist/utils/index.js"
    },
    "./theme": {
      "import": "./dist/theme.js"
    }
  }
}
